# NVIDIA NIM API key — get yours free at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: Cloudflare Worker URL for proxying YouTube transcript requests.
# Deploy cloudflare-worker.js to Cloudflare Workers (free tier) and set this URL.
# This bypasses YouTube's IP blocking on cloud deployments like Render.
# Example: YOUTUBE_PROXY_URL=https://youtube-transcript-proxy.YOUR-NAME.workers.dev
YOUTUBE_PROXY_URL=

# Optional: Custom Invidious instances (comma-separated).
# Defaults are built-in and work out of the box. Only set this if you want
# to use specific instances or self-hosted Invidious.
# Example: INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://yewtu.be
INVIDIOUS_INSTANCES=